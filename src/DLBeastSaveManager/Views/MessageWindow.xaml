<views:ThemedWindow x:Class="DLBeastSaveManager.Views.MessageWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DLBeastSaveManager.Views"
                    Width="430" SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">

    <StackPanel Margin="18">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Style="{StaticResource Muted.Text}" />
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" />
    </StackPanel>
</views:ThemedWindow>
