<views:ThemedWindow x:Class="DLBeastSaveManager.Views.RestoreConfirmDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DLBeastSaveManager.Views"
                    Title="Restore save"
                    Width="580" SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">

    <StackPanel Margin="18">
        <TextBlock Text="Restore this snapshot?" Style="{StaticResource Heading}" FontSize="16" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
        <TextBlock Text="Your current save is snapshotted and pinned first, so this can be undone."
                   Style="{StaticResource Muted.Text}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <Border x:Name="GameWarning" Background="#3A211F" BorderBrush="{StaticResource Danger}"
                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,14,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="The game is still running" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted.Text}" Margin="0,4,0,0"
                           Text="Close it completely first, or the next in-game save overwrites what you put back." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Check again" Click="OnRecheckGame" />
                    <Button Content="Restore anyway" Click="OnOverrideGame" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="CloudWarning" Background="#3A2E14" BorderBrush="{StaticResource Warn}"
                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="CloudHeader" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted.Text}" Margin="0,4,0,0"
                           Text="Steam can put its cloud copy back at the next launch. Turn Cloud off for this game first:" />
                <TextBlock x:Name="CloudHowTo" TextWrapping="Wrap" Margin="0,6,0,0"
                           FontFamily="Consolas" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Open Steam" Click="OnOpenSteam" />
                    <Button Content="I have turned it off" Click="OnRecheckCloud" Margin="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel x:Name="ScopePanel" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Put back" Style="{StaticResource Heading}" Margin="0,0,0,4" />
            <StackPanel x:Name="ScopeOptions" />
        </StackPanel>

        <CheckBox x:Name="ResetCacheCheck" Margin="0,14,0,0"
                  Content="Also reset Steam's cloud cache - only if a restore did not stick" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
            <Button x:Name="RestoreButton" Content="Restore" Style="{StaticResource Danger.Button}"
                    Click="OnRestore" Margin="0" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
