<views:ThemedWindow x:Class="DLBeastSaveManager.Views.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DLBeastSaveManager.Views"
                    Title="DL:TB Save Manager"
                    Height="540" Width="820" MinHeight="360" MinWidth="640"
                    WindowStartupLocation="CenterScreen">

    <views:ThemedWindow.Resources>
        <views:StateToBrushConverter x:Key="StateBrush" />
        <views:EmptyToCollapsedConverter x:Key="EmptyCollapse" />
        <views:InverseBooleanConverter x:Key="Not" />
    </views:ThemedWindow.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,12,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="{Binding SavePathText}" Style="{StaticResource Muted.Text}"
                               FontFamily="Consolas" FontSize="12" Margin="18,4,12,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SavePathText}" />

                    <TextBlock Text="{Binding CloudWarningText}" Foreground="{StaticResource Warn}"
                               Margin="18,6,12,0" TextWrapping="Wrap"
                               Visibility="{Binding CloudWarningText, Converter={StaticResource EmptyCollapse}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding WatchButtonText}" Command="{Binding ToggleWatchCommand}" />
                    <Button Content="Settings" Click="OnSettingsClick" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <Button Content="Backup now" Style="{StaticResource Primary.Button}"
                    Command="{Binding BackupNowCommand}" />
            <Button Content="Restore selected" Style="{StaticResource Danger.Button}"
                    Command="{Binding RestoreCommand}" />
            <Button Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}" Margin="16,0,8,0" />
            <Button Content="Rename" Command="{Binding RenameCommand}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Snapshots}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AlternationCount="2"
                  MouseDoubleClick="OnGridDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding RunTooltip}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding PinGlyph}" Width="30" />
                <DataGridTextColumn Header="Taken" Binding="{Binding WhenText}" Width="160" />
                <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="100" />
                <DataGridTextColumn Header="Run" Binding="{Binding RunText}" Width="240" />
                <DataGridTextColumn Header="Note" Binding="{Binding Label}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource Muted.Text}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding CountsText}" Style="{StaticResource Muted.Text}" />
        </Grid>
    </Grid>
</views:ThemedWindow>
