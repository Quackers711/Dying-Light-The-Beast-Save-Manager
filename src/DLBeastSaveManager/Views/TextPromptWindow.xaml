<views:ThemedWindow x:Class="DLBeastSaveManager.Views.TextPromptWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DLBeastSaveManager.Views"
                    Width="430" SizeToContent="Height"
                    ResizeMode="NoResize"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">

    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Style="{StaticResource Muted.Text}"
                   Margin="0,0,0,10" />
        <TextBox x:Name="Input" KeyDown="OnKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" MinWidth="84" />
            <Button Content="OK" IsDefault="True" Click="OnOk" Margin="0" MinWidth="84"
                    Style="{StaticResource Primary.Button}" />
        </StackPanel>
    </StackPanel>
</views:ThemedWindow>
