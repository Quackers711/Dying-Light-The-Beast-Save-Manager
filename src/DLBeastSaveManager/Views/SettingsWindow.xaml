<views:ThemedWindow x:Class="DLBeastSaveManager.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:DLBeastSaveManager.Views"
                    Title="Settings"
                    Height="580" Width="620" MinHeight="420" MinWidth="560"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Save folder" Style="{StaticResource Heading}" />
                        <ComboBox x:Name="LocationCombo" SelectionChanged="OnLocationChanged" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SavePathBox" Grid.Column="0" FontFamily="Consolas" FontSize="12"
                                     TextChanged="OnSavePathChanged" />
                            <Button Grid.Column="1" Content="Browse" Click="OnBrowseSave" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="SavePathStatus" Style="{StaticResource Muted.Text}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Backup folder" Style="{StaticResource Heading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupPathBox" Grid.Column="0" FontFamily="Consolas" FontSize="12" />
                            <Button Grid.Column="1" Content="Browse" Click="OnBrowseBackup" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Backups" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="AutoBackupCheck" Content="Back up automatically when the game saves" />
                        <CheckBox x:Name="KeepEverythingCheck" Content="Keep every snapshot"
                                  Checked="OnRetentionChanged" Unchecked="OnRetentionChanged" />
                        <StackPanel x:Name="KeepRow" Orientation="Horizontal" Margin="25,4,0,0">
                            <TextBlock Text="Otherwise keep the last" VerticalAlignment="Center" />
                            <TextBox x:Name="KeepLastBox" Width="56" Margin="8,0" />
                            <TextBlock Text="snapshots" VerticalAlignment="Center"
                                       Style="{StaticResource Muted.Text}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="HotkeysCheck" Content="Enable global hotkeys" />
                        <Grid Margin="25,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Backup now" VerticalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BackupHotkeyBox" Width="170"
                                     IsReadOnly="True" PreviewKeyDown="OnHotkeyCapture" Tag="Backup"
                                     Margin="0,0,8,6" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Click="OnClearHotkey"
                                    Tag="Backup" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pin latest" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PinHotkeyBox" Width="170"
                                     IsReadOnly="True" PreviewKeyDown="OnHotkeyCapture" Tag="Pin"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Click="OnClearHotkey"
                                    Tag="Pin" Margin="0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Muted.Text}" TextWrapping="Wrap" Margin="25,8,0,0"
                                   Text="Click a box and press the key you want. Does not work in exclusive fullscreen." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource Heading}" />
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Closing the window keeps it running in the tray" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="Save" Style="{StaticResource Primary.Button}" Click="OnSave" Margin="0" />
        </StackPanel>
    </Grid>
</views:ThemedWindow>
